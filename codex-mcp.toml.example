[mcp_servers.deepseek_harness]
command = "<PLUGIN_ROOT>/.venv/bin/python"
args = ["<PLUGIN_ROOT>/scripts/launch.py"]
cwd = "<PLUGIN_ROOT>"
startup_timeout_sec = 30
tool_timeout_sec = 3660
enabled = true
default_tools_approval_mode = "prompt"
env_vars = ["DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL", "DEEPSEEK_MODEL", "DEEPSEEK_HARNESS_HOME", "DEEPSEEK_HARNESS_DATA_HOME", "DEEPSEEK_HARNESS_NODE", "DEEPSEEK_HARNESS_CLI", "DEEPSEEK_HARNESS_ALLOWED_ROOTS"]
